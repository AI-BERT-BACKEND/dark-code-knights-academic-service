### ================================================================
### FASE 3 — Registro de Notas (R08)
### Prerequisito: fase-1 y fase-2 ejecutados
###
### Estado inicial:
###   subjectId=1 "Cálculo Diferencial"
###   cutId=5 (Corte 1, 30%)  cutId=6 (Corte 2, 30%)  cutId=7 (Corte 3, 40%)
###   Sin notas registradas
###
### IDs resultantes al terminar este archivo:
###   gradeId=1  cutId=5  "Parcial 1"  4.5  60%
###   gradeId=2  cutId=5  "Quiz 1"     3.0  40%
###   → Corte 1 average = (4.5*60 + 3.0*40) / 100 = 3.90
###   → overallAverage  = 3.90 * 30 / 100 = 1.17  (solo 1 corte calificado)
### ================================================================

@baseUrl = http://localhost:8002
@ct = application/json
@s1 = 1
@cut1 = 5
@cut2 = 6
@cut3 = 7


# ------------------------------------------------------------------
# CASO 1 — Error: nota fuera de rango (> 5.0) → 422 Unprocessable Entity
# Espera: { "success": false, "error": "La nota 6.0 está fuera del rango...", "code": 422 }
# ------------------------------------------------------------------
### POST nota con gradeValue=6.0 en cut1
POST {{baseUrl}}/api/v1/subjects/{{s1}}/cuts/{{cut1}}/grades
Content-Type: {{ct}}

{
  "activityName": "Parcial Invalido",
  "gradeValue": 6.0,
  "percentage": 50
}


# ------------------------------------------------------------------
# CASO 2 — Error: nota negativa → 422 Unprocessable Entity
# Espera: error de validación @DecimalMin
# ------------------------------------------------------------------
### POST nota con gradeValue=-1.0
POST {{baseUrl}}/api/v1/subjects/{{s1}}/cuts/{{cut1}}/grades
Content-Type: {{ct}}

{
  "activityName": "Parcial Invalido",
  "gradeValue": -1.0,
  "percentage": 50
}


# ------------------------------------------------------------------
# CASO 3 — Error: porcentaje = 0 → 400 Bad Request
# Espera: error de validación @DecimalMin en percentage
# ------------------------------------------------------------------
### POST nota con percentage=0
POST {{baseUrl}}/api/v1/subjects/{{s1}}/cuts/{{cut1}}/grades
Content-Type: {{ct}}

{
  "activityName": "Parcial Invalido",
  "gradeValue": 4.0,
  "percentage": 0
}


# ------------------------------------------------------------------
# CASO 4 — Error: corte inexistente → 404 Not Found
# Espera: { "success": false, "error": "Materia con id 1 no encontrada", "code": 404 }
# ------------------------------------------------------------------
### POST nota en cutId=999
POST {{baseUrl}}/api/v1/subjects/{{s1}}/cuts/999/grades
Content-Type: {{ct}}

{
  "activityName": "Parcial",
  "gradeValue": 4.0,
  "percentage": 100
}


# ------------------------------------------------------------------
# CASO 5 — Registrar primera nota en Corte 1 → 201 Created
# gradeId=1, cutId=5, "Parcial 1", 4.5, 60%
# → Corte 1 average = 4.50  (solo 60% del corte calificado)
# Espera: grade con id=1
# ------------------------------------------------------------------
### POST "Parcial 1" en cut1 — gradeId=1
POST {{baseUrl}}/api/v1/subjects/{{s1}}/cuts/{{cut1}}/grades
Content-Type: {{ct}}

{
  "activityName": "Parcial 1",
  "gradeValue": 4.5,
  "percentage": 60
}


# ------------------------------------------------------------------
# CASO 6 — Intentar editar estructura BLOQUEADA → 409 Conflict
# Ya hay una nota en el corte, la estructura no puede modificarse
# Espera: { "success": false, "error": "...no puede editarse porque ya tiene notas...", "code": 409 }
# ------------------------------------------------------------------
### PUT evaluation-structure con nota ya registrada
PUT {{baseUrl}}/api/v1/subjects/{{s1}}/evaluation-structure
Content-Type: {{ct}}

{
  "evaluationCuts": [
    { "cutName": "Nuevo Corte", "cutPercentage": 100 }
  ]
}


# ------------------------------------------------------------------
# CASO 7 — Registrar segunda nota en Corte 1 → 201 Created
# gradeId=2, cutId=5, "Quiz 1", 3.0, 40%
# → Corte 1 average = (4.5*60 + 3.0*40) / (60+40) = 390/100 = 3.90
# Espera: grade con id=2
# ------------------------------------------------------------------
### POST "Quiz 1" en cut1 — gradeId=2
POST {{baseUrl}}/api/v1/subjects/{{s1}}/cuts/{{cut1}}/grades
Content-Type: {{ct}}

{
  "activityName": "Quiz 1",
  "gradeValue": 3.0,
  "percentage": 40
}


# ------------------------------------------------------------------
# CASO 8 — Error: capacidad del corte excedida → 422 Unprocessable Entity
# Corte 1 ya tiene 100% distribuido (60%+40%), no caben más actividades
# Espera: { "success": false, "error": "No es posible agregar la actividad...", "code": 422 }
# ------------------------------------------------------------------
### POST nota en cut1 ya lleno al 100%
POST {{baseUrl}}/api/v1/subjects/{{s1}}/cuts/{{cut1}}/grades
Content-Type: {{ct}}

{
  "activityName": "Taller Extra",
  "gradeValue": 4.0,
  "percentage": 10
}


# ------------------------------------------------------------------
# CASO 9 — Listar notas de Corte 1 → 200 OK
# Espera: lista con 2 notas (gradeId=1 y gradeId=2)
# ------------------------------------------------------------------
### GET grades del cut1
GET {{baseUrl}}/api/v1/subjects/{{s1}}/cuts/{{cut1}}/grades


# ------------------------------------------------------------------
# CASO 10 — Listar notas de Corte 2 → 200 OK (lista vacía)
# Espera: { "success": true, "data": [], "message": "ok" }
# ------------------------------------------------------------------
### GET grades del cut2 (sin notas aún)
GET {{baseUrl}}/api/v1/subjects/{{s1}}/cuts/{{cut2}}/grades


# ------------------------------------------------------------------
# CASO 11 — Consultar promedios con solo Corte 1 calificado → 200 OK
# Espera:
#   cuts[0] (Corte 1): grade=3.90
#   cuts[1] (Corte 2): grade=null (omitido)
#   cuts[2] (Corte 3): grade=null (omitido)
#   overallAverage = 3.90 * 30 / 100 = 1.17
# ------------------------------------------------------------------
### GET averages de subject id=1
GET {{baseUrl}}/api/v1/subjects/{{s1}}/averages
